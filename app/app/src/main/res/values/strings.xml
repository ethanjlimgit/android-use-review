    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to\nPhoneGPT</string>
    <string name="onboarding_welcome_subtitle">An AI that takes action so you don\'t have to</string>
    <string name="onboarding_get_started">Get Started</string>

    <string name="onboarding_privacy_title">Your Privacy Comes First</string>
    <string name="onboarding_privacy_body">PhoneGPT is built to help you, not harvest your data</string>
    <string name="onboarding_privacy_screen_title">Screen data never stored</string>
    <string name="onboarding_privacy_screen_body">What PhoneGPT sees is processed in the moment, then immediately discarded. Nothing is saved.</string>
    <string name="onboarding_privacy_data_title">Your data is never sold</string>
    <string name="onboarding_privacy_data_body">We make money from subscriptions, not your data. No advertisers. No third parties. Period.</string>
    <string name="onboarding_privacy_control_title">You\'re always in control</string>
    <string name="onboarding_privacy_control_body">Revoke permissions, pause automation, or delete everything instantly. No lock-in, no hassle.</string>

    <string name="onboarding_accessibility_title">Let PhoneGPT see your screen</string>
    <string name="onboarding_accessibility_body">PhoneGPT needs to see what\'s on your screen to help you complete tasks</string>
    <string name="onboarding_accessibility_card_title">Your data stays</string>
    <string name="onboarding_accessibility_safe">Safe &amp; private</string>
    <string name="onboarding_accessibility_no_recording">No screen recording</string>
    <string name="onboarding_accessibility_on_device">On your device only</string>

    <string name="onboarding_accessibility_guide_title">How to give PhoneGPT access</string>
    <string name="onboarding_accessibility_guide_step1">Find and tap \"PhoneGPT\" from the list of apps</string>
    <string name="onboarding_accessibility_guide_step2">Turn the switch ON, then tap OK to confirm</string>

    <string name="onboarding_overlay_title">Let PhoneGPT show controls on screen</string>
    <string name="onboarding_overlay_body">PhoneGPT needs to display buttons on your screen while it works</string>
    <string name="onboarding_overlay_card_title">This lets you</string>
    <string name="onboarding_overlay_benefit1">Stop or pause tasks</string>
    <string name="onboarding_overlay_benefit2">Talk to PhoneGPT anytime</string>
    <string name="onboarding_overlay_benefit3">See what PhoneGPT is doing</string>
    <string name="onboarding_overlay_learn_more_message">PhoneGPT will show a small control panel that appears on top of your other apps. You can use this to talk to PhoneGPT, pause what it\'s doing, or see its progress - all without closing the app you\'re using.</string>

    <string name="onboarding_overlay_guide_title">How to allow screen controls</string>
    <string name="onboarding_overlay_guide_step1">Find and tap \"PhoneGPT\" from the list of apps</string>
    <string name="onboarding_overlay_guide_step2">Turn ON \"Allow display over other apps\"</string>

    <string name="onboarding_recognition_title">Let PhoneGPT hear your voice</string>
    <string name="onboarding_recognition_body">PhoneGPT needs to use your microphone to hear your voice commands</string>
    <string name="onboarding_recognition_card_title">This lets you</string>
    <string name="onboarding_recognition_benefit1">Talk to PhoneGPT instead of typing</string>
    <string name="onboarding_recognition_benefit2">Give commands hands-free</string>
    <string name="onboarding_recognition_benefit3">Get things done faster</string>
    <string name="onboarding_recognition_learn_more_message">PhoneGPT can listen when you speak to it. This means you can ask PhoneGPT to do things by talking - no need to type. It\'s easier and faster, especially when your hands are busy.</string>

    <string name="onboarding_recognition_guide_title">How to allow microphone</string>
    <string name="onboarding_recognition_guide_step1">Tap \"Allow\" on the popup that appears</string>
    <string name="onboarding_recognition_guide_step2">This lets PhoneGPT hear when you talk to it</string>
    <string name="onboarding_recognition_permission_denied">You didn\'t allow microphone access. You can turn it on later in your phone settings if you change your mind.</string>
    <string name="onboarding_recognition_rationale">PhoneGPT needs to hear you so it can understand what you want it to do.</string>
    <string name="onboarding_recognition_waiting">Tap the button below to continue</string>

    <string name="onboarding_assistant_title">Make PhoneGPT your main assistant</string>
    <string name="onboarding_assistant_body">Let PhoneGPT respond when you ask your phone for help</string>
    <string name="onboarding_assistant_benefits">This lets you</string>
    <string name="onboarding_assistant_benefit1">Open PhoneGPT from any app</string>
    <string name="onboarding_assistant_benefit2">Hold your home button to talk to PhoneGPT</string>
    <string name="onboarding_assistant_benefit3">Get help faster</string>
    <string name="onboarding_assistant_optional">You can skip this step if you want</string>

    <string name="onboarding_success_title">All Set!</string>
    <string name="onboarding_success_message">PhoneGPT is ready to help you with anything</string>

