<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AndroidUse" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/androiduse_primary</item>
        <item name="colorPrimaryVariant">@color/androiduse_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/androiduse_secondary</item>
        <item name="colorSecondaryVariant">@color/androiduse_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- Background colors -->
        <item name="android:colorBackground">#1A1E1C</item>
        <item name="colorSurface">#252A27</item>
        <item name="colorOnSurface">@color/white</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#A6E9CE</item>
        <item name="android:textColorHint">#78CAB0</item>
        <!-- Ripple effect -->
        <item name="colorControlHighlight">@color/androiduse_ripple</item>
        <!-- Card style -->
        <item name="materialCardViewStyle">@style/Widget.AndroidUse.CardView</item>
        <!-- Button style -->
        <item name="materialButtonStyle">@style/Widget.AndroidUse.Button</item>
        <!-- Switch style -->
        <item name="switchStyle">@style/Widget.AndroidUse.Switch</item>
        <!-- TextInputLayout style -->
        <item name="textInputStyle">@style/Widget.AndroidUse.TextInputLayout</item>
        <!-- Cursor and selection handle colors -->
        <item name="colorControlActivated">@color/androiduse_primary</item>
        <!-- SeekBar style -->
        <item name="android:seekBarStyle">@style/Widget.AndroidUse.SeekBar</item>
        <!-- Enable window content transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/fade</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
    </style>
    
    <style name="Widget.AndroidUse.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">#2A332F</item>
        <item name="rippleColor">@color/androiduse_ripple</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.AndroidUse.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/androiduse_primary</item>
        <item name="rippleColor">@color/androiduse_ripple</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="elevation">4dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.AndroidUse.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/androiduse_primary</item>
        <item name="trackTint">@color/androiduse_primary_light</item>
    </style>

    <style name="Widget.AndroidUse.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/androiduse_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="hintTextColor">@color/androiduse_primary</item>
        <item name="android:textColorHint">@color/androiduse_text_secondary</item>
        <item name="endIconTint">@color/androiduse_primary</item>
        <item name="boxBackgroundColor">#2A332F</item>
    </style>

    <style name="Widget.AndroidUse.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressTint">@color/androiduse_primary</item>
        <item name="android:thumbTint">@color/androiduse_primary</item>
        <item name="android:progressBackgroundTint">@color/androiduse_divider</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <style name="Widget.AndroidUse.Button.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/androiduse_primary</item>
        <item name="strokeColor">@color/androiduse_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">@color/androiduse_ripple</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.AndroidUse.Chip.Filter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="chipStrokeColor">@color/androiduse_primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconVisible">false</item>
        <item name="rippleColor">@color/androiduse_ripple</item>
    </style>

    <!-- Transparent theme for dialog activities -->
    <style name="Theme.AndroidUse.Transparent" parent="Theme.AndroidUse">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>