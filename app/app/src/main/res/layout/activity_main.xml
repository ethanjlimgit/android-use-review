<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <!-- Fixed Header Section -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md"
        android:background="@drawable/bg_gradient_main"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

                <!-- Logo and Title -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Back button (shown in history mode) -->
                    <FrameLayout
                        android:id="@+id/backButton"
                        android:layout_width="@dimen/logo_size"
                        android:layout_height="@dimen/logo_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="@color/text_primary"
                            android:contentDescription="Back" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/logoImage"
                        android:layout_width="@dimen/logo_size"
                        android:layout_height="@dimen/logo_size"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="@string/content_description_logo" />

                    <TextView
                        android:id="@+id/headerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="@string/header_title"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <!-- Backend Connection Status Indicator -->
                    <View
                        android:id="@+id/connectionStatusIndicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/status_indicator_inactive" />
                </LinearLayout>

                <!-- Settings Button -->
                <FrameLayout
                    android:id="@+id/settingsButton"
                    android:layout_width="@dimen/profile_button_size"
                    android:layout_height="@dimen/profile_button_size"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_floating_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        android:contentDescription="@string/content_description_settings_icon" />
                </FrameLayout>

                <!-- Profile Button -->
                <FrameLayout
                    android:id="@+id/profileButton"
                    android:layout_width="@dimen/profile_button_size"
                    android:layout_height="@dimen/profile_button_size"
                    android:background="@drawable/bg_floating_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        android:contentDescription="@string/content_description_profile" />
                </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomInputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_md">

            <!-- Main Title Section -->
            <TextView
                android:id="@+id/mainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/main_title_margin_top"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:text="@string/main_prompt"
                android:textSize="42sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:lineSpacingExtra="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Suggested Actions Section -->
            <LinearLayout
                android:id="@+id/suggestedActionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/suggested_actions_margin_top"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                app:layout_constraintTop_toBottomOf="@id/mainTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Section Header -->
                <TextView
                    android:id="@+id/suggestedActionsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/suggested_actions_title"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />

                <!-- Action Cards Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Card 1: Reply to Text -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardWallpaper"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/card_min_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_card"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="@dimen/card_corner_radius">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md">

                            <ImageView
                                android:layout_width="@dimen/icon_size_action_card"
                                android:layout_height="@dimen/icon_size_action_card"
                                android:src="@drawable/ic_send"
                                android:contentDescription="Send message icon"
                                app:tint="@color/text_primary" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/action_wallpaper_title"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:lineHeight="20dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2: Uber -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardUber"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/card_min_height"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_card"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="@dimen/card_corner_radius">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md">

                            <ImageView
                                android:layout_width="@dimen/icon_size_action_card"
                                android:layout_height="@dimen/icon_size_action_card"
                                android:src="@drawable/ic_car"
                                android:contentDescription="Car icon"
                                app:tint="@color/text_primary" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/action_uber_title"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:lineHeight="20dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Action Cards Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Card 3: Doordash -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDoordash"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/card_min_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_card"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="@dimen/card_corner_radius">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md">

                            <ImageView
                                android:layout_width="@dimen/icon_size_action_card"
                                android:layout_height="@dimen/icon_size_action_card"
                                android:src="@drawable/ic_food"
                                android:contentDescription="Food icon"
                                app:tint="@color/text_primary" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/action_doordash_title"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:lineHeight="20dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 4: Silent Mode -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSilentMode"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/card_min_height"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_card"
                        app:strokeWidth="0dp"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="@dimen/card_corner_radius">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md">

                            <ImageView
                                android:layout_width="@dimen/icon_size_action_card"
                                android:layout_height="@dimen/icon_size_action_card"
                                android:src="@drawable/ic_volume_off"
                                android:contentDescription="Volume off icon"
                                app:tint="@color/text_primary" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/action_silent_mode_title"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:lineHeight="20dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- View History Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewHistoryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:text="View Task History"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                app:icon="@drawable/ic_history"
                app:iconTint="@color/text_primary"
                app:iconGravity="start"
                app:backgroundTint="@color/background_card"
                app:strokeWidth="0dp"
                app:cornerRadius="24dp"
                app:layout_constraintTop_toBottomOf="@id/suggestedActionsContainer"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Task History Container (shown when in history mode) -->
            <FrameLayout
                android:id="@+id/taskHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Loading indicator -->
                <ProgressBar
                    android:id="@+id/historyLoadingProgress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Empty state -->
                <TextView
                    android:id="@+id/historyEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="No tasks yet"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <!-- Task history list with pull to load more -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/historySwipeRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/taskHistoryRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/spacing_md" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Input Container -->
    <LinearLayout
        android:id="@+id/bottomInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Partial Speech Result -->
        <TextView
            android:id="@+id/partialSpeechText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/text_card_background"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone"
            android:alpha="0.9" />

        <!-- Bottom Input Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/inputBarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/background_input"
            app:strokeWidth="0dp"
            app:cardCornerRadius="@dimen/input_bar_corner_radius"
            app:cardElevation="0dp">

            <!-- AI Input Fragment -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/aiInputFragmentContainer"
                android:name="com.androiduse.autopilot.ui.AiInputFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
