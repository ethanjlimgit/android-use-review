<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/survey_role_question_company"
        android:textSize="28sp"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuestion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgRoles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSoftwareEngineer"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_software_engineer" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipProductManager"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_product_manager" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDesigner"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_designer" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCEO"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_ceo" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFounder"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_founder" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCTO"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_cto" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEngineer"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_engineer" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDataScientist"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_data_scientist" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMarketing"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_marketing" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSales"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_sales" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCustomerSupport"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_customer_support" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOperations"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_operations" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHR"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_hr" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFinance"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_finance" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAnalyst"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_analyst" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipManager"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_manager" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDirector"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_director" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVP"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_vp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipConsultant"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_consultant" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFreelancer"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_freelancer" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStudent"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_student" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipResearcher"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_researcher" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTeacher"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_teacher" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDeveloper"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_developer" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQA"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_qa" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDevOps"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_devops" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSecurity"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_security" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdmin"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_admin" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLegal"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_legal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOther"
                    style="@style/Widget.AndroidUse.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/survey_role_other" />

            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCustomRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/androiduse_primary"
                app:hintTextColor="@color/androiduse_primary"
                app:cursorColor="@color/androiduse_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/survey_role_custom_hint"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray_light"
                    android:inputType="text"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
