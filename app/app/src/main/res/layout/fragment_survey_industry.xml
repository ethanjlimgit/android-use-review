<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/survey_industry_question"
        android:textSize="28sp"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuestion"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupIndustry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTechnology"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_technology" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHealthcare"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_healthcare" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFinance"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_finance" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEducation"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_education" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRetail"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_retail" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipManufacturing"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_manufacturing" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRealEstate"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_real_estate" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTransportation"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_transportation" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMarketing"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_marketing" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLegal"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_legal" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNonProfit"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_non_profit" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGovernment"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_government" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEntertainment"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_entertainment" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHospitality"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_hospitality" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipConstruction"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_construction" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAgriculture"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_agriculture" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOther"
                style="@style/Widget.AndroidUse.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey_industry_other" />

        </com.google.android.material.chip.ChipGroup>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/survey_button_next"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:enabled="false"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/androiduse_primary"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
