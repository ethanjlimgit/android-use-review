<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top edge glow - extended reach for scale animation -->
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#A054D48C"
                android:centerColor="#2054D48C"
                android:endColor="#00000000"
                android:centerY="0.15" />
        </shape>
    </item>
    <!-- Bottom edge glow - extended reach for scale animation -->
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#A054D48C"
                android:centerColor="#2054D48C"
                android:endColor="#00000000"
                android:centerY="0.15" />
        </shape>
    </item>
    <!-- Left edge glow - extended reach for scale animation -->
    <item android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#A054D48C"
                android:centerColor="#2054D48C"
                android:endColor="#00000000"
                android:centerX="0.08" />
        </shape>
    </item>
    <!-- Right edge glow - extended reach for scale animation -->
    <item android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="180"
                android:startColor="#A054D48C"
                android:centerColor="#2054D48C"
                android:endColor="#00000000"
                android:centerX="0.08" />
        </shape>
    </item>
</layer-list>
