<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0D0D" />
        </shape>
    </item>

    <!-- Radial gradient overlay (green glow) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.3"
                android:gradientRadius="400dp"
                android:startColor="#1A4CAF50"
                android:centerColor="#0D2A4A2D"
                android:endColor="#000D0D0D" />
        </shape>
    </item>
</layer-list>
