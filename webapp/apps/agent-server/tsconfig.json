{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@droiduse/shared-lib": ["../../packages/shared-lib"],
      "@droiduse/shared-lib/*": ["../../packages/shared-lib/*"],
      "@droiduse/shared-prisma": ["../../packages/shared-prisma"],
      "@droiduse/shared-prisma/*": ["../../packages/shared-prisma/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
