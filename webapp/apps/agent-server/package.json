{
  "name": "@droiduse/agent-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-server": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env --include 'prompts/**' --include '*.json' src/cli.ts -- serve",
    "dev:debug": "tsx watch --env-file=.env --include 'prompts/**' --include '*.json' src/cli.ts -- serve --debug",
    "build": "tsc",
    "start": "node dist/cli.js serve",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run --project agent-server",
    "test:watch": "vitest --project agent-server",
    "test:coverage": "vitest run --project agent-server --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@droiduse/shared-lib": "workspace:*",
    "@droiduse/shared-prisma": "workspace:*",
    "@google/adk": "^0.3.0",
    "@google/genai": "^1.37.0",
    "@prisma/adapter-pg": "^7.2.0",
    "commander": "^13.1.0",
    "eventemitter3": "^5.0.1",
    "fastify": "^5.3.3",
    "jsonwebtoken": "^9.0.2",
    "nunjucks": "^3.2.4",
    "openai": "^4.103.0",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "posthog-node": "^5.24.4",
    "sharp": "^0.34.3",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.0.3",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.0.16"
  }
}
