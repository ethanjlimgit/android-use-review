{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@droiduse/shared-ui": ["../../packages/shared-ui"],
      "@droiduse/shared-ui/*": ["../../packages/shared-ui/*"],
      "@droiduse/shared-lib": ["../../packages/shared-lib"],
      "@droiduse/shared-lib/*": ["../../packages/shared-lib/*"],
      "@droiduse/shared-prisma": ["../../packages/shared-prisma"],
      "@droiduse/shared-prisma/*": ["../../packages/shared-prisma/*"],
      "@droiduse/email-prisma": ["../../packages/email-prisma"],
      "@droiduse/email-prisma/*": ["../../packages/email-prisma/*"],
      "@droiduse/email-components": ["../../packages/email-components"],
      "@droiduse/email-components/*": ["../../packages/email-components/*"]
    }
  }
}
