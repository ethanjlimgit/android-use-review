{
  "name": "androiduse-infrastructure",
  "version": "1.0.0",
  "description": "AndroidUse DigitalOcean Infrastructure with Pulumi",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "generate-userdata": "npx ts-node scripts/generate-userdata.ts frontend dev",
    "preview": "pulumi preview",
    "up": "pulumi up",
    "destroy": "pulumi destroy",
    "stack:dev": "pulumi stack select dev",
    "stack:prod": "pulumi stack select prod",
    "deploy:dev": "pulumi stack select dev && pulumi up --yes",
    "deploy:prod": "pulumi stack select prod && pulumi up --yes",
    "deploy-images": "bash scripts/deploy-images.sh all",
    "deploy-images:frontend": "bash scripts/deploy-images.sh frontend",
    "deploy-images:backend": "bash scripts/deploy-images.sh backend",
    "deploy-images:admin": "bash scripts/deploy-images.sh admin"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "typescript": "^5.9.3",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@pulumi/command": "^1.1.3",
    "@pulumi/digitalocean": "^4.56.0",
    "@pulumi/pulumi": "^3.216.0",
    "@pulumi/random": "^4.19.0"
  }
}
